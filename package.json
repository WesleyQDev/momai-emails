{
  "name": "momai-emails",
  "version": "1.1.2",
  "private": true,
  "description": "Extensão completa de e-mails via SMTP/IMAP para MomAI",
  "author": "WesleyQDev",
  "license": "MIT",
  "main": "runtime.ts",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "package": "node ../package-extension.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.runtime.json",
    "test": "vitest run"
  },
  "dependencies": {
    "dompurify": "^3.2.4",
    "imapflow": "^1.0.170",
    "mailparser": "^3.7.2",
    "nodemailer": "^6.10.0",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@heroicons/react": "^2.2.0",
    "@types/dompurify": "^3.2.0",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0",
    "vitest": "2.1.9"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
